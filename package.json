{
  "name": "slim-app",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --minify",
    "build:js": "mkdir -p public/assets/js && cp node_modules/jquery/dist/jquery.min.js public/assets/js/jquery.min.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "jquery": "^3.7.1",
    "tailwindcss": "^3.4.17"
  }
}
